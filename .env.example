# Frontend Supabase Configuration
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Server-Side Configuration (Never exposed to frontend)
SUPABASE_SECRET_KEY="your-supabase-service-role-secret"
AI_API_KEY="your-ai-api-key"
GEMINI_API_KEY="your-gemini-api-key"

# LiveKit Configuration for Video/Audio Rooms
LIVEKIT_URL="wss://your-livekit-server.livekit.cloud"
LIVEKIT_API_KEY="your-livekit-api-key"
LIVEKIT_API_SECRET="your-livekit-api-secret"

# Resend Email Configuration
RESEND_API_KEY="your-resend-api-key"

# Application Host URL
APP_URL="http://localhost:3000"

# Optional real Supabase demo accounts.
# Set both passwords in a secure deployment secret manager to enable provisioning.
# The default emails are rathika.sri.demo@learnx.test and ram.demo@learnx.test.
LEARNX_DEMO_MENTOR_PASSWORD=""
LEARNX_DEMO_LEARNER_PASSWORD=""
# Optional email overrides:
# LEARNX_DEMO_MENTOR_EMAIL=""
# LEARNX_DEMO_LEARNER_EMAIL=""
# Optional JSON array of additional demo account definitions. Keep the value in
# a secure secret manager because each definition includes a password.
# LEARNX_ADDITIONAL_DEMO_ACCOUNTS_JSON=""
